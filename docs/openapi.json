  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PreferenceValues": {
        "properties": {
          "course_scores": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Course Scores"
          },
          "early_penalty_per_week": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Early Penalty Per Week"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PreferenceValues"
      },
      "PreferencesRequest": {
        "properties": {
          "preferences": {
            "$ref": "#/components/schemas/PreferenceValues"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "preferences"
        ],
        "title": "PreferencesRequest"
      },
      "RecommendRequest": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "initial",
              "adjustment",
              "supplement"
            ],
            "title": "Purpose"
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "default": 3
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_id",
          "purpose"
        ],
        "title": "RecommendRequest"
      },
      "Round1SubmitRequest": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "section_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Section Ids"
          },
          "expected_plan_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Plan Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_id",
          "section_ids",
          "expected_plan_revision"
        ],
        "title": "Round1SubmitRequest"
      },
      "Round2SubmitRequest": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "section_id": {
            "type": "string",
            "title": "Section Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_id",
          "section_id"
        ],
        "title": "Round2SubmitRequest"
      },
      "Round2WithdrawRequest": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "expected_plan_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Plan Revision"
          },
          "section_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Section Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_id",
          "expected_plan_revision",
          "section_ids"
        ],
        "title": "Round2WithdrawRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WithdrawRequest": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "expected_plan_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Plan Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_id",
          "expected_plan_revision"
        ],
        "title": "WithdrawRequest"
      }
    }
  }
}
